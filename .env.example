# Copy to .env.local for development. On Vercel add these under Project Settings > Environment Variables.

# Resend (https://resend.com): sends the contact form email.
RESEND_API_KEY=
# Where enquiries are delivered. Defaults to rayne@omniray.org.
CONTACT_TO_EMAIL=rayne@omniray.org
# Must be on a domain verified in Resend, e.g. "OmniRay <hello@omniray.org>".
# Left empty it uses Resend's test sender, which can only deliver to your own Resend account email.
CONTACT_FROM_EMAIL=

# Optional Cloudflare Turnstile (https://dash.cloudflare.com/?to=/:account/turnstile).
# Set both to turn on the captcha. The form is protected by a honeypot, a timing check and a
# rate limit either way.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
